{
  // Nuancier — application statique servie par un Worker Cloudflare.
  // Tout le calcul colorimétrique vit dans le navigateur ; le Worker ne
  // sert que les fichiers. Il a porté une API de partage de palettes,
  // retirée avec les liens de partage : plus d'API, plus de stockage.
  "$schema": "node_modules/wrangler/config-schema.json",
  // ⚠ CE NOM EST L'ADRESSE EN LIGNE, ne pas le changer à la légère :
  // c'est lui qui donne front-outil-palette-de-couleurs.<compte>.workers.dev.
  //
  // Il valait « nuancier » : le déploiement automatique publiait donc un
  // SECOND Worker, à une autre adresse, pendant que l'adresse réellement
  // utilisée continuait d'afficher le `front.js` collé à la main. Les
  // déploiements réussissaient, et personne ne voyait rien changer.
  //
  // Le Worker « nuancier-back » séparé et son service binding BACK ne
  // servent plus à rien : il n'y a plus d'API du tout.
  "name": "front-outil-palette-de-couleurs",
  "main": "back/index.ts",
  "compatibility_date": "2026-07-01",
  // Explicite plutôt que par défaut : c'est l'adresse workers.dev qui est
  // en usage, elle ne doit pas dépendre d'un réglage du dashboard.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA : toute route inconnue sert index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
