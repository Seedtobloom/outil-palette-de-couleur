{
  // Nuancier — front (SPA statique) + back (API de persistance) sur un
  // seul Worker Cloudflare. Le moteur colorimétrique reste côté client :
  // le Worker ne fait que sauvegarder et servir les palettes partagées.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuancier",
  "main": "back/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA : toute route inconnue sert index.html…
    "not_found_handling": "single-page-application",
    // …sauf l'API, qui doit atteindre le Worker.
    "run_worker_first": ["/api/*"]
  },
  // Stockage des palettes partagées — il ne sert QU'aux liens de partage.
  // L'identifiant du namespace n'est pas un secret : c'est une référence,
  // pas une clé d'accès. Il a sa place dans le dépôt, comme le nom du
  // Worker. Le Worker sait se déployer sans (les routes de partage
  // répondent alors « partage non activé »), mais ici il est configuré.
  "kv_namespaces": [
    {
      "binding": "NUANCIER_KV",
      "id": "5f14f21e2dc4498c836ab018cff3a225"
    }
  ],
  "observability": { "enabled": true }
}
